# Ejemplo: ruta local de SQLite. No se carga automáticamente; exportar en el sistema.
DB_PATH=./data/finanzas.sqlite3

# Si la aplicación está detrás del proxy Apache /finanzas:
# APP_BASE_PATH=/finanzas
# Configure FINANZAS_INITIAL_ADMIN_PASSWORD mediante una variable real del entorno, NO la publique.

# Contraseña inicial: establecer SOLO como variable del entorno y nunca confirmar un valor real en Git.
# FINANZAS_INITIAL_ADMIN_PASSWORD=

# S4: activarlo al usar HTTPS detrás de Apache; no usar con localhost HTTP.
# FINANZAS_COOKIE_SECURE=1
# Al inicializar SQLite nuevo bajo APP_BASE_PATH se requiere contraseña inicial de 12+.
# FINANZAS_REQUIRE_STRONG_ADMIN_PASSWORD=1
